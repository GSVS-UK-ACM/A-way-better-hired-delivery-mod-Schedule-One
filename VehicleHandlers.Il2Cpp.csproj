<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>VehicleHandlers</RootNamespace>
    <AssemblyName>VehicleHandlers</AssemblyName>
    <Version>0.1.0</Version>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>TRACE;Il2Cpp</DefineConstants>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Il2Cpp\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Source\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(MelonLoaderRoot)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(MelonLoaderRoot)\net6\0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(MelonLoaderRoot)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(MelonLoaderRoot)\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="Il2CppInterop.HarmonySupport" HintPath="$(MelonLoaderRoot)\net6\Il2CppInterop.HarmonySupport.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(MelonLoaderRoot)\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Il2CppScheduleOne.Core" HintPath="$(MelonLoaderRoot)\Il2CppAssemblies\Il2CppScheduleOne.Core.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(MelonLoaderRoot)\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppFishNet.Runtime" HintPath="$(MelonLoaderRoot)\Il2CppAssemblies\Il2CppFishNet.Runtime.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(MelonLoaderRoot)\Il2CppAssemblies\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(MelonLoaderRoot)\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(MelonLoaderRoot)\Il2CppAssemblies\UnityEngine.IMGUIModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateMelonLoaderRoot" BeforeTargets="ResolveReferences">
    <Error Condition="'$(MelonLoaderRoot)' == ''" Text="Set MelonLoaderRoot to the matching game's MelonLoader directory." />
    <Error Condition="!Exists('$(MelonLoaderRoot)\net6\MelonLoader.dll')" Text="MelonLoaderRoot does not contain net6\MelonLoader.dll." />
    <Error Condition="!Exists('$(MelonLoaderRoot)\Il2CppAssemblies\Assembly-CSharp.dll')" Text="MelonLoaderRoot does not contain Il2CppAssemblies\Assembly-CSharp.dll." />
  </Target>
</Project>

